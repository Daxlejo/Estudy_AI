# Server Port
PORT=3000

# SQLite Database Connection URL
DATABASE_URL="file:./dev.db"

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173"

# Final exam cooldown duration in minutes after a failing attempt
EXAM_COOLDOWN_MINUTES=60

# OpenAI API Key required for AI-assisted course, session, quiz, and exam generation
OPENAI_API_KEY="sk-..."

# OpenAI Model used for generation and validation (default: gpt-6.1-sol)
OPENAI_MODEL="gpt-6.1-sol"
